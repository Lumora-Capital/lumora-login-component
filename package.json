{
	"name": "@volenday/lumora-login-component",
	"version": "3.0.0",
	"type": "module",
	"description": "A reusable passwordless React TypeScript login component with Google and Microsoft OAuth, magic link, passkeys, API integration, and responsive design (Tailwind CSS + Radix)",
	"main": "dist/index.cjs",
	"module": "dist/index.es.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.es.js",
			"require": "./dist/index.cjs"
		},
		"./styles.css": "./dist/lumora-login.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "NODE_ENV=production vite build && npm run build:css",
		"build:types": "tsc --emitDeclarationOnly",
		"preview": "vite preview",
		"type-check": "tsc --noEmit",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"prepublishOnly": "npm run build",
		"build:css": "tailwindcss -i src/styles.css -o dist/lumora-login.css --minify"
	},
	"keywords": [
		"react",
		"typescript",
		"login",
		"authentication",
		"oauth",
		"passkey",
		"webauthn",
		"magic-link",
		"tailwind",
		"component",
		"radix",
		"shadcn"
	],
	"author": "Volenday",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Volenday/lumora-login-component.git"
	},
	"peerDependencies": {
		"@hookform/resolvers": ">=5.0.0",
		"@react-oauth/google": ">=0.12.0",
		"axios": ">=1.6.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"yup": ">=1.0.0"
	},
	"dependencies": {
		"@simplewebauthn/browser": "^14.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.66.0",
		"radix-ui": "^1.8.1",
		"react-hook-form": "^7.48.2",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.37.0",
		"@hookform/resolvers": "^5.2.2",
		"@react-oauth/google": "^0.12.2",
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@typescript-eslint/eslint-plugin": "^8.46.0",
		"@typescript-eslint/parser": "^8.46.0",
		"@vitejs/plugin-react": "^5.0.4",
		"axios": "^1.6.0",
		"eslint-plugin-react-hooks": "^6.1.1",
		"eslint-plugin-react-refresh": "^0.4.23",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.3.3",
		"ts-jest": "^29.4.4",
		"typescript": "^5.9.3",
		"vite": "^7.1.9",
		"vite-plugin-dts": "^4.5.4",
		"vite-tsconfig-paths": "^5.1.4",
		"yup": "^1.7.1"
	},
	"sideEffects": [
		"*.css"
	]
}
